DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# 生产环境保持 true；仅在明确接受明文传输风险的临时 HTTP 部署中设为 false。
DJANGO_COOKIE_SECURE=true
# 必填：顺达真实纳税人识别号，用于判定进项与销项；不要填写公开示例值。
COMPANY_TAX_ID=
SHUNDA_APP_DIR=/volume4/docker/docker/shunda-finance/app
SHUNDA_DATA_DIR=/volume4/docker/docker/shunda-finance/data
SHUNDA_WEB_IMAGE_TAG=v0.0.0
SHUNDA_UPDATER_IMAGE_TAG=v0.0.0
SHUNDA_UPDATER_TOKEN=
IMPORT_MAX_UPLOAD_BYTES=20971520
IMPORT_MAX_ROWS=100000
DATABASE_URL=
POSTGRES_DB=shunda_finance
POSTGRES_USER=
POSTGRES_PASSWORD=
